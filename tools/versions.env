# Python tools of the gates (feat-5, Tasks 130.110 to 130.142; feat-22-python-tools-lockfile). These are
# the direct tools. Their dependencies and all checksums are in the lock files in tools/python/
# (just check-pins compares the version of each tool in its lock file with the version here).
# These tools do not go to users, so rule A applies (only the main license).
# license-expression, Apache-2.0 (the wheel has a data file under CC-BY-4.0). Its dependency
# boolean.py (BSD-2-Clause) is in tools/python/license-expression.lock.
LICENSE_EXPRESSION_VERSION=30.4.4
# specmgr (the PyPI package biz-dfch-specmgr), AGPL-3.0-or-later
SPECMGR_VERSION=0.38.0
# PyYAML, MIT (the gates for workflows read the YAML with it)
PYYAML_VERSION=6.0.3
