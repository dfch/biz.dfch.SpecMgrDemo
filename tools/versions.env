# Python for the gates (feat-22-python-tools-lockfile), PSF-2.0 (the class Permitted since 2026-11-04).
# The minor version. The lock files in tools/python/ are valid for each 3.13 release. The gate scripts
# start `uv venv --python 3.13`, and uv downloads a managed Python if no 3.13 is on the machine.
PYTHON_VERSION=3.13

